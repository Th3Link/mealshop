{
  "name": "@mealshop/nextcloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "npm run check && vite build",
    "check": "npm run check:native && npm run check:vue",
    "test": "vitest run --config vitest.config.ts && node --test tests/typecheck.test.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e/*.ts\" \"*.ts\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "check:native": "tsc --noEmit -p tsconfig.native.json",
    "check:vue": "node scripts/check-vue.mjs --noEmit"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "9.14.1",
    "vue": "^3.5.24",
    "vue-router": "^5.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.1.3",
    "@typescript/typescript6": "6.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "packageManager": "npm@12.2.3"
}
