  "phases": {
    "water": {
      "kind": "water",
      "name": "Prepare brewing water",
      "translations": {
        "de": "Brauwasser vorbereiten"
      },
      "instruction": "Record the water volume and recipe-specific target temperature.",
      "instruction_translations": {
        "de": "Erfasse Wassermenge und rezeptabhängige Zieltemperatur."
      }
    },
    "extract": {
      "kind": "extract",
      "name": "Add malt extract",
      "translations": {
        "de": "Malzextrakt zugeben"
      },
      "instruction": "Record the actual extract type, quantity and addition time.",
      "instruction_translations": {
        "de": "Erfasse die tatsächliche Extraktart, Menge und den Zugabezeitpunkt."
      }
    },
    "boil": {
      "kind": "boil",
      "name": "Boil and record additions",
      "translations": {
        "de": "Würzekochen und Zugaben erfassen"
      },
      "instruction": "Enter recipe-specific boil time and individual hop or extract additions.",
      "instruction_translations": {
        "de": "Erfasse rezeptabhängige Kochdauer und einzelne Hopfen- oder Extraktzugaben."
      }
    },
    "cool": {
      "kind": "cool",
      "name": "Cool wort",
      "translations": {
        "de": "Würze kühlen"
      },
      "instruction": "Record your actual chiller, target and measured temperature.",
      "instruction_translations": {
        "de": "Erfasse deinen tatsächlichen Kühler sowie Ziel- und Messtemperatur."
      }
    },
    "transfer": {
      "kind": "transfer",
      "name": "Transfer and measure wort",
      "translations": {
        "de": "Würze umfüllen und messen"
      },
      "instruction": "Record the transferred volume and original gravity in their actual units.",
      "instruction_translations": {
        "de": "Erfasse umgefüllte Menge und Stammwürze in den tatsächlichen Einheiten."
      }
    },
    "pitch": {
      "kind": "pitch",
      "name": "Pitch selected yeast",
      "translations": {
        "de": "Gewählte Hefe anstellen"
      },
      "instruction": "Use the selected yeast instructions and record quantity and actual temperature.",
      "instruction_translations": {
        "de": "Verwende die Anleitung der gewählten Hefe und erfasse Menge und tatsächliche Temperatur."
      }
    },
    "ferment": {
      "kind": "ferment",
      "name": "Monitor fermentation",
      "translations": {
        "de": "Gärung beobachten"
      },
      "instruction": "Record the planned observation window and original readings. Completion is explicit.",
      "instruction_translations": {
        "de": "Erfasse den geplanten Beobachtungszeitraum und originale Messwerte. Der Abschluss wird ausdrücklich bestätigt."
      }
    },
    "package": {
      "kind": "package",
      "name": "Review and package",
      "translations": {
        "de": "Abfüllung prüfen und durchführen"
      },
      "instruction": "Record the actual packaging actions and measurements from your recipe.",
      "instruction_translations": {
        "de": "Erfasse tatsächliche Abfüllschritte und Messwerte aus deinem Rezept."
      }
    },
    "clean": {
      "kind": "clean",
      "name": "Clean equipment",
      "translations": {
        "de": "Ausrüstung reinigen"
      },
      "instruction": "Use the actual equipment instructions and release resources when finished.",
      "instruction_translations": {
        "de": "Beachte die tatsächlichen Geräteanleitungen und gib Ressourcen nach Abschluss frei."
      }
    },
    "steep": {
      "kind": "steep",
      "name": "Steep specialty grains",
      "translations": {
        "de": "Spezialmalz einweichen"
      },
      "instruction": "Use the selected recipe and record the steeping time and temperature.",
      "instruction_translations": {
        "de": "Übernimm Einweichdauer und Temperatur aus dem gewählten Rezept."
      }
    },
    "lauter": {
      "kind": "lauter",
      "name": "Separate grain and wort",
      "translations": {
        "de": "Läutern"
      },
      "instruction": "Record the actual grain-separation step for your equipment.",
      "instruction_translations": {
        "de": "Erfasse die tatsächliche Trennung von Treber und Würze für deine Anlage."
      }
    },
    "mash": {
      "kind": "mash",
      "name": "Mash",
      "translations": {
        "de": "Maischen"
      },
      "instruction": "Enter the actual mash rests and measured temperatures from your recipe.",
      "instruction_translations": {
        "de": "Erfasse die tatsächlichen Maischerasten und gemessenen Temperaturen deines Rezepts."
      }
    },
    "bag_lift": {
      "kind": "bag_lift",
      "name": "Lift and drain the bag",
      "translations": {
        "de": "Maischesack herausheben und abtropfen"
      },
      "instruction": "Follow the actual bag and kettle instructions; record the drained volume.",
      "instruction_translations": {
        "de": "Beachte die Anleitung für deinen Sack und Kessel; erfasse die abgelaufene Menge."
      }
    },
    "basket_lift": {
      "kind": "basket_lift",
      "name": "Lift and drain the malt basket",
      "translations": {
        "de": "Malzkorb herausheben und abtropfen"
      },
      "instruction": "Follow the selected model manual before lifting or draining the basket.",
      "instruction_translations": {
        "de": "Beachte vor dem Herausheben und Abtropfen die Anleitung deines Modells."
      }
    },
    "sparge": {
      "kind": "sparge",
      "name": "Sparge as selected",
      "translations": {
        "de": "Gewählten Nachguss durchführen"
      },
      "instruction": "Enter the chosen sparge volumes and collection phases.",
      "instruction_translations": {
        "de": "Erfasse die gewählten Nachgussmengen und Auffangschritte."
      }
    },
    "malt_pipe_lift": {
      "kind": "malt_pipe_lift",
      "name": "Remove and drain the malt pipe",
      "translations": {
        "de": "Malzrohr herausheben und abtropfen"
      },
      "instruction": "Follow the selected Braumeister model instructions for malt-pipe removal.",
      "instruction_translations": {
        "de": "Beachte beim Herausheben des Malzrohrs die Anleitung deines Braumeister-Modells."
      }
    }
  }
}
